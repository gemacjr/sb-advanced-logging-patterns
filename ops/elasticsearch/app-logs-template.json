{
  "index_patterns": ["app-logs-*"],
  "priority": 200,
  "template": {
    "settings": { "number_of_replicas": 0 },
    "mappings": {
      "dynamic_templates": [
        { "strings_as_keywords": { "match_mapping_type": "string", "mapping": { "type": "keyword", "ignore_above": 1024 } } }
      ],
      "properties": {
        "@timestamp":  { "type": "date_nanos" },
        "sequence":    { "type": "long" },
        "message":     { "type": "text" },
        "stack_trace": { "type": "text" }
      }
    }
  }
}
